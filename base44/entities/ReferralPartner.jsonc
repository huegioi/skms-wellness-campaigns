{
  "name": "ReferralPartner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Partner's full name or organization name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Partner's email address"
    },
    "company": {
      "type": "string",
      "description": "Partner's company or brokerage name"
    },
    "phone": {
      "type": "string",
      "description": "Partner's phone number"
    },
    "address": {
      "type": "string",
      "description": "Partner's mailing or office address"
    },
    "tier": {
      "type": "string",
      "enum": [
        "Tier 1",
        "Tier 2",
        "Tier 3"
      ],
      "description": "Partner tier for prioritization (Tier 1 = highest value)"
    },
    "renewal_cohort": {
      "type": "string",
      "enum": [
        "Jan 1",
        "July 1",
        "Off-Cycle"
      ],
      "description": "Primary renewal cohort this partner's clients belong to"
    },
    "last_touchpoint_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last meaningful touchpoint with this partner"
    },
    "unique_portal_id": {
      "type": "string",
      "description": "Unique token used to access the referral portal"
    },
    "agreement_file_url": {
      "type": "string",
      "description": "URL to the signed partnership agreement document"
    },
    "agreement_signed_date": {
      "type": "string",
      "format": "date",
      "description": "Date the agreement was signed"
    },
    "commission_tiers": {
      "type": "array",
      "description": "Tiered commission rates based on annual first-year revenue.",
      "items": {
        "type": "object",
        "properties": {
          "min_revenue": {
            "type": "number"
          },
          "max_revenue": {
            "type": "number"
          },
          "rate": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "ytd_revenue": {
      "type": "number",
      "default": 0,
      "description": "Year-to-date first-year revenue from placed clients"
    },
    "total_commissions_paid": {
      "type": "number",
      "default": 0,
      "description": "Total commissions paid to this partner to date"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the partnership is currently active"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this partner"
    },
    "follow_up_stage": {
      "type": "string",
      "description": "Current follow-up stage for this partner"
    },
    "follow_up_due_date": {
      "type": "string",
      "format": "date",
      "description": "Date the next follow-up is due"
    },
    "owner": {
      "type": "string",
      "description": "Team member responsible for this partner relationship"
    },
    "last_contacted_date": {
      "type": "string",
      "format": "date",
      "description": "Date this partner was last contacted"
    },
    "partner_status": {
      "type": "string",
      "enum": [
        "Prospect",
        "Active Partner",
        "Inactive"
      ],
      "description": "Current status of the partner relationship"
    },
    "referral_count": {
      "type": "number",
      "default": 0,
      "description": "Total number of referrals submitted by this partner"
    }
  },
  "required": [
    "name",
    "email",
    "unique_portal_id"
  ]
}