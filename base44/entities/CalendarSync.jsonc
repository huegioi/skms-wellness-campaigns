{
  "name": "CalendarSync",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email for this sync config"
    },
    "google_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Google Calendar sync enabled"
    },
    "google_calendar_id": {
      "type": "string",
      "description": "Google Calendar ID to sync with"
    },
    "google_sync_direction": {
      "type": "string",
      "enum": [
        "to_google",
        "from_google",
        "both"
      ],
      "default": "both",
      "description": "Sync direction for Google"
    },
    "outlook_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Outlook Calendar sync enabled"
    },
    "outlook_calendar_id": {
      "type": "string",
      "description": "Outlook Calendar ID to sync with"
    },
    "outlook_sync_direction": {
      "type": "string",
      "enum": [
        "to_outlook",
        "from_outlook",
        "both"
      ],
      "default": "both",
      "description": "Sync direction for Outlook"
    },
    "sync_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords to filter external events"
    },
    "last_google_sync": {
      "type": "string",
      "format": "date-time",
      "description": "Last Google sync timestamp"
    },
    "last_outlook_sync": {
      "type": "string",
      "format": "date-time",
      "description": "Last Outlook sync timestamp"
    }
  },
  "required": [
    "user_email"
  ]
}