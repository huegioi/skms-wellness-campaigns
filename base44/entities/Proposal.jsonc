{
  "name": "Proposal",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Associated client ID"
    },
    "client_name": {
      "type": "string",
      "description": "Client name for display"
    },
    "client_email": {
      "type": "string",
      "description": "Client email address"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "total_amount": {
      "type": "number",
      "description": "Total proposal amount"
    },
    "narrative_summary": {
      "type": "string",
      "description": "Customizable narrative summary of services"
    },
    "selections": {
      "type": "object",
      "description": "All selected items and quantities"
    },
    "invoiced_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of items that have been invoiced"
    },
    "matched_stage": {
      "type": "string",
      "description": "Closest campaign stage from the Quick Builder / Curriculum Designer (e.g. 'Stage 2 — Habit'). Recomputed when selections change in the proposal wizard."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "accepted",
        "declined"
      ],
      "default": "draft",
      "description": "Proposal status"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the proposal was sent"
    },
    "viewed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the proposal was first viewed"
    },
    "last_reminder_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the last reminder was sent"
    },
    "reminder_count": {
      "type": "number",
      "default": 0,
      "description": "Number of reminders sent"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True if this record is demo/broker-demo sample data. Excluded from dashboard/analytics metrics."
    }
  },
  "required": [
    "client_name",
    "total_amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "user"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "user"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "user"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "user"
          ]
        }
      }
    }
  }
}