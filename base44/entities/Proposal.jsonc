{
  "name": "Proposal",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Associated client ID"
    },
    "client_name": {
      "type": "string",
      "description": "Client name for display"
    },
    "client_email": {
      "type": "string",
      "description": "Client email address"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "total_amount": {
      "type": "number",
      "description": "Total proposal amount"
    },
    "narrative_summary": {
      "type": "string",
      "description": "Customizable narrative summary of services"
    },
    "selections": {
      "type": "object",
      "description": "All selected items and quantities"
    },
    "invoiced_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of items that have been invoiced"
    },
    "matched_stage": {
      "type": "string",
      "description": "Closest campaign stage from the Quick Builder / Curriculum Designer (e.g. 'Stage 2 \u2014 Habit'). Recomputed when selections change in the proposal wizard."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "accepted",
        "declined"
      ],
      "default": "draft",
      "description": "Proposal status"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the proposal was sent"
    },
    "viewed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the proposal was first viewed"
    },
    "last_reminder_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the last reminder was sent"
    },
    "reminder_count": {
      "type": "number",
      "default": 0,
      "description": "Number of reminders sent"
    },
    "quickbooks_invoice_id": {
      "type": "string",
      "description": "QuickBooks invoice ID once the invoice has been created via the review gate. When set, the Prepare QB Invoice button is replaced with the 'Already invoiced' state and the gate refuses re-send."
    },
    "quickbooks_doc_number": {
      "type": "string",
      "description": "QuickBooks DocNumber assigned to the invoice created via the review gate."
    },
    "is_sample": {
      "type": "boolean",
      "default": false,
      "description": "Vestigial \u2014 present on all existing records (always false) but not read or written by any code in the codebase. Retained so live records don't carry an undeclared key. Do not use; is_demo is the active demo-data flag."
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True if this record is demo/broker-demo sample data. Excluded from dashboard/analytics metrics."
    }
  },
  "required": [
    "client_name",
    "total_amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}