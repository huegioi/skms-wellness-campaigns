{
  "name": "Presenter",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Presenter's full name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Presenter's email address"
    },
    "phone": {
      "type": "string",
      "description": "Presenter's phone number as typed. Free text \u2014 phone_e164 is what actually gets texted."
    },
    "phone_e164": {
      "type": "string",
      "description": "The same number normalized to E.164 (+16122371146). Twilio only accepts this shape; derived automatically from `phone` on save."
    },
    "sms_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "Whether this presenter agreed to receive texts. Carriers require provable consent \u2014 no text is sent without this."
    },
    "sms_opt_in_at": {
      "type": "string",
      "format": "date-time",
      "description": "When consent was recorded. This timestamp IS the proof of consent \u2014 do not clear it when re-saving."
    },
    "sms_opt_out_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set when the presenter replies STOP (Twilio returns error 21610). Once set, texting stops permanently unless they re-subscribe with START."
    },
    "unique_portal_id": {
      "type": "string",
      "description": "Unique token used to access the presenter portal"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this presenter is currently active"
    },
    "default_rate": {
      "type": "number",
      "description": "Default pay rate for this presenter (placeholder for Stage 2)"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this presenter"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}