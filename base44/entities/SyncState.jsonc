{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Identifier for what this sync state tracks (e.g. 'broker_sheet')"
    },
    "page_token": {
      "type": "string",
      "description": "Google Drive Changes API page token — persisted between webhook invocations"
    }
  },
  "required": [
    "page_token"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}