{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Primary contact name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Primary contact email address"
    },
    "email2": {
      "type": "string",
      "format": "email",
      "description": "Secondary contact email address"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "title": {
      "type": "string",
      "description": "Job title"
    },
    "industry": {
      "type": "string",
      "description": "Industry sector"
    },
    "company_size": {
      "type": "string",
      "enum": [
        "1-50",
        "51-200",
        "201-500",
        "501-1000",
        "1001-5000",
        "5000+"
      ],
      "description": "Number of employees"
    },
    "company_address": {
      "type": "string",
      "description": "Company address"
    },
    "company_website": {
      "type": "string",
      "description": "Company website URL"
    },
    "wellness_budget": {
      "type": "number",
      "description": "Annual wellness dollar fund/budget"
    },
    "plan_year_start": {
      "type": "string",
      "format": "date",
      "description": "Plan year start date"
    },
    "wellness_fund_size": {
      "type": "number",
      "description": "Per-employee wellness fund size (dollar amount)"
    },
    "renewal_date": {
      "type": "string",
      "format": "date",
      "description": "Client renewal date"
    },
    "owner": {
      "type": "string",
      "description": "Team member responsible for this client (e.g. William, Heather)"
    },
    "client_stage": {
      "type": "string",
      "enum": [
        "discovery_call_scheduled",
        "discovery_call_complete",
        "proposal_sent",
        "proposal_viewed",
        "negotiation",
        "verbal_yes",
        "new_client_setup",
        "program_delivery",
        "followup_feedback",
        "nurture",
        "renewal_outreach",
        "re_engage",
        "churned"
      ],
      "description": "Current lifecycle/sales stage of the client relationship"
    },
    "tier": {
      "type": "string",
      "enum": [
        "Tier 1",
        "Tier 2",
        "Tier 3"
      ],
      "description": "Client tier for prioritization"
    },
    "renewal_cohort": {
      "type": "string",
      "enum": [
        "Jan 1",
        "July 1",
        "Off-Cycle"
      ],
      "description": "Which renewal cohort this client belongs to"
    },
    "last_touchpoint_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last meaningful touchpoint with this client"
    },
    "brokers": {
      "type": "array",
      "description": "List of brokers associated with this client",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "broker_name": {
      "type": "string",
      "description": "Legacy: single broker name (use brokers array instead)"
    },
    "broker_email": {
      "type": "string",
      "description": "Legacy: single broker email (use brokers array instead)"
    },
    "wellness_consultant_name": {
      "type": "string",
      "description": "Wellness consultant name"
    },
    "wellness_consultant_email": {
      "type": "string",
      "format": "email",
      "description": "Wellness consultant email address"
    },
    "referral_partner_id": {
      "type": "string",
      "description": "ID of the ReferralPartner who referred this client"
    },
    "referral_partner_name": {
      "type": "string",
      "description": "Display name of the referring partner"
    },
    "last_contacted": {
      "type": "string",
      "format": "date-time",
      "description": "Date of last contact"
    },
    "related_contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Additional contacts at this company"
    },
    "purchased_services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of previously purchased service IDs"
    },
    "total_invoice_value": {
      "type": "number",
      "description": "Total value of all invoices from QuickBooks",
      "default": 0
    },
    "invoice_count": {
      "type": "number",
      "description": "Number of invoices from QuickBooks",
      "default": 0
    },
    "invoice_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of invoice IDs associated with this client"
    },
    "portal_template_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Manually selected email template IDs for client portal"
    },
    "portal_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "uploaded_date": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "Custom documents uploaded for this client's portal"
    },
    "session_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "resource_type": {
            "type": "string",
            "enum": [
              "recording",
              "presentation",
              "handout",
              "other"
            ]
          },
          "session_name": {
            "type": "string"
          },
          "added_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Links to session recordings, PPT files, and handout files for the client portal"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the client"
    },
    "last_service_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last service delivered to this client"
    },
    "follow_up_window_days": {
      "type": "number",
      "default": 90,
      "description": "Number of days after last service before a follow-up is needed"
    },
    "last_contacted_date": {
      "type": "string",
      "format": "date",
      "description": "Date client was last contacted for follow-up purposes"
    },
    "follow_up_status": {
      "type": "string",
      "enum": [
        "needs_followup",
        "contacted",
        "booked",
        "snoozed"
      ],
      "description": "Current follow-up status for this client"
    },
    "snooze_until": {
      "type": "string",
      "format": "date",
      "description": "Hide from follow-up queue until this date"
    },
    "april_checkin_year": {
      "type": "number",
      "description": "Year the April check-in was last completed"
    },
    "november_checkin_year": {
      "type": "number",
      "description": "Year the November check-in was last completed"
    },
    "stage_entered_date": {
      "type": "string",
      "format": "date",
      "description": "Date the client entered the current stage \u2014 used for stall detection"
    }
  },
  "required": [
    "name",
    "email"
  ]
}