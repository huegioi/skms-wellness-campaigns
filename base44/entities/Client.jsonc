{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Primary contact name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Primary contact email address"
    },
    "email2": {
      "type": "string",
      "format": "email",
      "description": "Secondary contact email address"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "linkedin_url": {
      "type": "string",
      "description": "LinkedIn profile URL"
    },
    "title": {
      "type": "string",
      "description": "Job title"
    },
    "industry": {
      "type": "string",
      "description": "Industry sector"
    },
    "company_size": {
      "type": "string",
      "enum": [
        "1-50",
        "51-200",
        "201-500",
        "501-1000",
        "1001-5000",
        "5000+"
      ],
      "description": "Number of employees"
    },
    "employee_count": {
      "type": "number",
      "description": "Actual employee headcount"
    },
    "company_address": {
      "type": "string",
      "description": "Company address"
    },
    "company_website": {
      "type": "string",
      "description": "Company website URL"
    },
    "wellness_budget": {
      "type": "number",
      "description": "Annual wellness dollar fund/budget"
    },
    "plan_year_start": {
      "type": "string",
      "format": "date",
      "description": "Plan year start date"
    },
    "wellness_fund_size": {
      "type": "number",
      "description": "Per-employee wellness fund size"
    },
    "renewal_date": {
      "type": "string",
      "format": "date",
      "description": "Client renewal date"
    },
    "owner": {
      "type": "string",
      "description": "Team member responsible for this client"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tag labels"
    },
    "client_stage": {
      "type": "string",
      "enum": [
        "discovery_call_scheduled",
        "discovery_call_complete",
        "proposal_sent",
        "proposal_viewed",
        "negotiation",
        "verbal_yes",
        "new_client_setup",
        "program_delivery",
        "followup_feedback",
        "event_follow_up",
        "nurture",
        "renewal_outreach",
        "re_engage",
        "churned"
      ],
      "description": "Current lifecycle stage"
    },
    "tier": {
      "type": "string",
      "enum": [
        "Tier 1",
        "Tier 2",
        "Tier 3"
      ],
      "description": "Client tier"
    },
    "renewal_cohort": {
      "type": "string",
      "enum": [
        "Jan 1",
        "July 1",
        "Off-Cycle"
      ],
      "description": "Renewal cohort"
    },
    "last_touchpoint_date": {
      "type": "string",
      "format": "date",
      "description": "Last meaningful touchpoint"
    },
    "brokers": {
      "type": "array",
      "description": "Brokers",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "broker_name": {
      "type": "string",
      "description": "Legacy: single broker name"
    },
    "broker_email": {
      "type": "string",
      "description": "Legacy: single broker email"
    },
    "wellness_consultant_name": {
      "type": "string",
      "description": "Wellness consultant name"
    },
    "wellness_consultant_email": {
      "type": "string",
      "format": "email",
      "description": "Wellness consultant email"
    },
    "referral_partner_id": {
      "type": "string",
      "description": "Referral partner ID"
    },
    "referral_partner_name": {
      "type": "string",
      "description": "Referring partner display name"
    },
    "last_contacted": {
      "type": "string",
      "format": "date-time",
      "description": "Last contact date"
    },
    "related_contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Additional contacts"
    },
    "purchased_services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Purchased service IDs"
    },
    "total_invoice_value": {
      "type": "number",
      "description": "Total invoice value",
      "default": 0
    },
    "invoice_count": {
      "type": "number",
      "description": "Invoice count",
      "default": 0
    },
    "invoice_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Invoice IDs"
    },
    "portal_template_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Portal email template IDs"
    },
    "portal_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "uploaded_date": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "Portal documents"
    },
    "session_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "resource_type": {
            "type": "string",
            "enum": [
              "recording",
              "presentation",
              "handout",
              "other"
            ]
          },
          "session_name": {
            "type": "string"
          },
          "added_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Session resources"
    },
    "notes": {
      "type": "string",
      "description": "Notes"
    },
    "last_service_date": {
      "type": "string",
      "format": "date",
      "description": "Last service date"
    },
    "follow_up_window_days": {
      "type": "number",
      "default": 90,
      "description": "Days after service before follow-up"
    },
    "last_contacted_date": {
      "type": "string",
      "format": "date",
      "description": "Last contacted date"
    },
    "follow_up_status": {
      "type": "string",
      "enum": [
        "needs_followup",
        "contacted",
        "booked",
        "snoozed"
      ],
      "description": "Follow-up status"
    },
    "snooze_until": {
      "type": "string",
      "format": "date",
      "description": "Hide from follow-up queue until"
    },
    "april_checkin_year": {
      "type": "number",
      "description": "April check-in year"
    },
    "november_checkin_year": {
      "type": "number",
      "description": "November check-in year"
    },
    "stage_entered_date": {
      "type": "string",
      "format": "date",
      "description": "Stage entered date"
    },
    "follow_up_due_date": {
      "type": "string",
      "format": "date",
      "description": "Manual follow-up due date"
    },
    "portal_token": {
      "type": "string",
      "description": "Portal token"
    },
    "attendee_emails_allowed": {
      "type": "boolean",
      "default": true,
      "description": "Whether automated attendee survey emails are allowed. When false, all survey sends are visibly skipped (never silently)."
    },
    "is_assessment_lead": {
      "type": "boolean",
      "default": false,
      "description": "True if this client was created from a Mental Fitness Score assessment intake. Excluded from follow-up queue, renewal logic, revenue/dashboard metrics, and Maya's briefing counts until converted."
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "Demo data flag."
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}