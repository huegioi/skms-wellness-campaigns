{
  "name": "Service",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Service name"
    },
    "category": {
      "type": "string",
      "enum": [
        "workshop",
        "challenge",
        "leadership",
        "class",
        "wellness_box"
      ],
      "description": "Service category"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the service"
    },
    "short_description": {
      "type": "string",
      "description": "Brief description for summaries"
    },
    "duration": {
      "type": "string",
      "description": "Duration (e.g., 1 hour, 14 days, 8 weeks)"
    },
    "duration_hours": {
      "type": "number",
      "description": "Duration in hours for calendar events"
    },
    "price": {
      "type": "number",
      "description": "Default price"
    },
    "price_label": {
      "type": "string",
      "description": "Price display label (e.g., per session, per participant)"
    },
    "target_audience": {
      "type": "string",
      "description": "Who this service is for"
    },
    "key_benefits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of key benefits"
    },
    "images": {
      "type": "array",
      "description": "Images for this service. The first image (index 0) is the primary image.",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Image URL (uploaded via file upload integration)"
          },
          "caption": {
            "type": "string",
            "description": "Optional caption for the image"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    "included_assessments": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "who5",
          "enps",
          "uwes3",
          "pss4",
          "ucla3",
          "cbi"
        ]
      },
      "description": "Validated assessments delivered with this service, beyond the standard session pulse."
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "resource_type": {
            "type": "string",
            "enum": [
              "handout",
              "presentation",
              "recording",
              "guide",
              "video",
              "audio",
              "link",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "uploaded_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Files and resources associated with this service (PDFs, guides, handouts, videos, audio, links)"
    },
    "presenter_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Display label for the material (e.g., 'Facilitation Guide', 'Slide Deck')"
          },
          "url": {
            "type": "string",
            "description": "URL to the material"
          }
        }
      },
      "description": "Links to decks, facilitation guides, and other prep materials shared with presenters"
    },
    "presenter_notes": {
      "type": "string",
      "description": "Run-of-show guidance and facilitation notes for presenters"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether service is available"
    },
    "public_visible": {
      "type": "boolean",
      "default": true,
      "description": "Whether this service is shown on the public Quick Builder"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within category"
    },
    "quickbooks_item_id": {
      "type": "string",
      "description": "QuickBooks item/product ID for invoice line item syncing. When set, invoice lines for this Service route to this Item; when unset, the category-level default from QB_CATEGORY_ITEM_DEFAULTS is used."
    },
    "qb_item_name": {
      "type": "string",
      "description": "Human-readable QuickBooks Item name for display in the admin UI only. Never used for matching or API calls \u2014 matching uses quickbooks_item_id."
    },
    "qb_box_key": {
      "type": "string",
      "description": "Wellness-box key from BOX_KEY_TO_SERVICE_NAME (e.g. 'reduceStress', 'largeEmotional'). Used to resolve box Services by stable key instead of by name. Only set on wellness_box category Services."
    }
  },
  "required": [
    "name",
    "category",
    "price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}