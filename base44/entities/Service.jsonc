{
  "name": "Service",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Service name"
    },
    "category": {
      "type": "string",
      "enum": [
        "workshop",
        "challenge",
        "leadership",
        "class",
        "wellness_box"
      ],
      "description": "Service category"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the service"
    },
    "short_description": {
      "type": "string",
      "description": "Brief description for summaries"
    },
    "duration": {
      "type": "string",
      "description": "Duration (e.g., 1 hour, 14 days, 8 weeks)"
    },
    "duration_hours": {
      "type": "number",
      "description": "Duration in hours for calendar events"
    },
    "price": {
      "type": "number",
      "description": "Default price"
    },
    "price_label": {
      "type": "string",
      "description": "Price display label (e.g., per session, per participant)"
    },
    "target_audience": {
      "type": "string",
      "description": "Who this service is for"
    },
    "key_benefits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of key benefits"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "resource_type": {
            "type": "string",
            "enum": [
              "handout",
              "presentation",
              "recording",
              "guide",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "uploaded_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Files and resources associated with this service (PDFs, guides, handouts)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether service is available"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within category"
    }
  },
  "required": [
    "name",
    "category",
    "price"
  ]
}