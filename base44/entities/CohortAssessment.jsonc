{
  "name": "CohortAssessment",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Associated client ID"
    },
    "service_id": {
      "type": "string",
      "description": "The specific challenge/service ID"
    },
    "proposal_id": {
      "type": "string",
      "description": "The accepted proposal ID (for cohort_start / cohort_end / cohort_1mo types)"
    },
    "participant_email": {
      "type": "string",
      "description": "Participant email (lowercased + trimmed) \u2014 used as the person key for pairing"
    },
    "participant_phone": {
      "type": "string",
      "description": "Participant phone number (optional)"
    },
    "survey_type": {
      "type": "string",
      "enum": [
        "challenge_day0",
        "challenge_day14",
        "cohort_start",
        "cohort_end",
        "cohort_1mo",
        "enps_post_session",
        "mfs"
      ],
      "description": "Which assessment point this row represents"
    },
    "instrument": {
      "type": "string",
      "enum": [
        "who5",
        "enps",
        "uwes3",
        "pss4",
        "ucla3",
        "cbi"
      ],
      "description": "Which validated instrument this row captures"
    },
    "instrument_total": {
      "type": "number",
      "description": "Computed total/composite score for the instrument"
    },
    "instrument_subscores": {
      "type": "object",
      "description": "Optional named sub-scale scores"
    },
    "item_responses": {
      "type": "object",
      "description": "Raw per-item answers keyed by item id"
    },
    "who5_cheerful": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "who5_calm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "who5_active": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "who5_rested": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "who5_interested": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "who5_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "cohort_year": {
      "type": "integer",
      "description": "Calendar year of this assessment"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the assessment was submitted"
    },
    "assessment_phase": {
      "type": "string",
      "default": "Phase 2",
      "description": "Assessment phase identifier"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True if this record is demo/broker-demo sample data."
    }
  },
  "required": [
    "participant_email",
    "survey_type",
    "submitted_at"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}