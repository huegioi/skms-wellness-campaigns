{
  "name": "CohortAssessment",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Associated client ID"
    },
    "service_id": {
      "type": "string",
      "description": "The specific challenge/service ID (for challenge_day0 / challenge_day14 types)"
    },
    "proposal_id": {
      "type": "string",
      "description": "The accepted proposal ID (for cohort_start / cohort_end types)"
    },
    "participant_email": {
      "type": "string",
      "description": "Participant email (lowercased + trimmed) \u2014 used as the person key for pairing"
    },
    "participant_phone": {
      "type": "string",
      "description": "Participant phone number (optional)"
    },
    "survey_type": {
      "type": "string",
      "enum": [
        "challenge_day0",
        "challenge_day14",
        "cohort_start",
        "cohort_end"
      ],
      "description": "Which assessment point this row represents"
    },
    "instrument": {
      "type": "string",
      "enum": [
        "who5",
        "enps",
        "uwes3",
        "pss4",
        "ucla3",
        "cbi"
      ],
      "description": "Which validated instrument this row captures"
    },
    "instrument_total": {
      "type": "number",
      "description": "Computed total/composite score for the instrument"
    },
    "instrument_subscores": {
      "type": "object",
      "description": "Optional named sub-scale scores (e.g. CBI personal/work/client burnout)"
    },
    "item_responses": {
      "type": "object",
      "description": "Raw per-item answers keyed by item id (e.g. {\"q1\": 3, \"q2\": 4})"
    },
    "who5_cheerful": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "WHO-5 Q1: Felt cheerful and in good spirits (0-5)"
    },
    "who5_calm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "WHO-5 Q2: Felt calm and relaxed (0-5)"
    },
    "who5_active": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "WHO-5 Q3: Felt active and vigorous (0-5)"
    },
    "who5_rested": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "WHO-5 Q4: Woke up feeling fresh and rested (0-5)"
    },
    "who5_interested": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "WHO-5 Q5: Daily life filled with interesting things (0-5)"
    },
    "who5_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "WHO-5 total score = sum of 5 items * 4 (0-100)"
    },
    "cohort_year": {
      "type": "integer",
      "description": "Calendar year of this assessment"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the assessment was submitted"
    },
    "assessment_phase": {
      "type": "string",
      "default": "Phase 2",
      "description": "Assessment phase identifier"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True if this record is demo/broker-demo sample data. Excluded from all dashboard/analytics metrics and wellbeing reports."
    }
  },
  "required": [
    "participant_email",
    "survey_type",
    "submitted_at"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}