{
  "name": "CampaignFollowUpLaunch",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string",
      "description": "Associated OutreachCampaign ID"
    },
    "launched_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this follow-up round was launched"
    },
    "guidance": {
      "type": "string",
      "description": "Operator guidance for Maya on how to frame this round's bumps"
    },
    "selected_ctas": {
      "type": "array",
      "description": "Snapshot of the CTAs selected for this launch (same shape as OutreachCampaign.selected_ctas). Later library edits do not mutate existing launches.",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "guidance": {
            "type": "string"
          }
        }
      }
    },
    "wait_days": {
      "type": "integer",
      "default": 3,
      "description": "Minimum days since the recipient's latest sent email to be eligible for this bump."
    },
    "recipient_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of follow-up recipient rows created by this launch"
    }
  },
  "required": [
    "campaign_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}