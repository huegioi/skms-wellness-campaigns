{
  "name": "ReferralActivity",
  "type": "object",
  "properties": {
    "referral_partner_id": {
      "type": "string",
      "description": "ID of the ReferralPartner this activity belongs to"
    },
    "referral_id": {
      "type": "string",
      "description": "ID of the Referral this activity relates to"
    },
    "message": {
      "type": "string",
      "description": "Human-readable activity message"
    },
    "activity_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the activity occurred"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "note",
        "commission_payment"
      ],
      "default": "note",
      "description": "Type of activity. 'commission_payment' entries carry an amount and feed the payments ledger."
    },
    "amount": {
      "type": "number",
      "description": "Payment amount (only set for commission_payment activities)"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True if this record is demo/broker-demo sample data. Excluded from dashboard/analytics metrics."
    }
  },
  "required": [
    "referral_partner_id",
    "message",
    "activity_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}