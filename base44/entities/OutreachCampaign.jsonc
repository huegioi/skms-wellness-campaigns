{
  "name": "OutreachCampaign",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Campaign name"
    },
    "description": {
      "type": "string",
      "description": "What this campaign is for"
    },
    "audience_type": {
      "type": "string",
      "enum": [
        "client",
        "partner",
        "lead",
        "referral_partner"
      ],
      "description": "Which entity type the audience is drawn from. 'partner' = union of Lead + ReferralPartner (deduped by email, prefer ReferralPartner). 'lead' and 'referral_partner' are legacy values kept for backward compatibility."
    },
    "audience_scope": {
      "type": "string",
      "enum": [
        "tags",
        "all"
      ],
      "default": "tags",
      "description": "Whether the audience is all records of the audience type ('all') or tag-matched ('tags'). When 'all', tag_ids is ignored and every non-demo record of the audience type is included."
    },
    "tag_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tag IDs \u2014 audience = records of audience_type having ANY of these tags. Ignored when audience_scope is 'all'."
    },
    "exclude_tag_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tag IDs \u2014 any record with ANY of these tags is excluded from the audience, regardless of scope. Exclude wins over include if a tag appears in both."
    },
    "owner_filter": {
      "type": "string",
      "enum": [
        "all",
        "william",
        "heather",
        "unassigned"
      ],
      "default": "all",
      "description": "Restricts the audience to records whose owner matches. 'all' applies no filter and includes records with no owner. 'unassigned' selects only records with a null or empty owner. Distinct from sender_mode, which controls who the email is sent from."
    },
    "subject_template": {
      "type": "string",
      "description": "Email subject skeleton; may contain merge hints like {{first_name}}"
    },
    "body_template": {
      "type": "string",
      "description": "Email body skeleton; may contain {{first_name}}, {{company}} merge hints and bracketed guidance like [PERSONALIZE: reference our last conversation]"
    },
    "personalization_notes": {
      "type": "string",
      "description": "Campaign-wide instructions to Maya for personalization"
    },
    "cc_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CC email addresses applied to every recipient draft"
    },
    "sender_mode": {
      "type": "string",
      "enum": [
        "record_owner",
        "william",
        "heather"
      ],
      "default": "record_owner",
      "description": "Who the email is sent from"
    },
    "template_source_id": {
      "type": "string",
      "description": "EmailTemplate ID this campaign was loaded from (optional)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generating",
        "in_review",
        "active",
        "completed",
        "archived"
      ],
      "default": "draft",
      "description": "Campaign lifecycle status"
    },
    "last_status_sync_at": {
      "type": "string",
      "format": "date-time",
      "description": "When syncCampaignSendStatus last refreshed send/reply counts for this campaign"
    },
    "selected_ctas": {
      "type": "array",
      "description": "Snapshot of the CTAs selected for this campaign at creation time. Each entry: { label, url, guidance }. Later library edits do not mutate existing campaigns.",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "guidance": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "audience_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}