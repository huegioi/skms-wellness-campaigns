{
  "name": "RateCardSetting",
  "type": "object",
  "description": "Price overrides for the rate card, edited on the Rate Card admin page. Exactly one record is active; the shipped defaults live in base44/shared/rateCard.ts and this record holds only the values that differ. Superseded records are kept with is_active false as an audit trail.",
  "properties": {
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Exactly one record is active; it is the one the app applies."
    },
    "overrides": {
      "type": "object",
      "description": "{ rates, challengeTiers, boxPrices, classPrices } - only keys that differ from the shipped defaults."
    },
    "note": {
      "type": "string",
      "description": "Why this change was made - shown in the history list."
    },
    "changed_summary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Human-readable list of what changed vs the shipped defaults."
    },
    "updated_by": {
      "type": "string",
      "description": "Email of the person who saved this version."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this version was saved."
    }
  },
  "required": [
    "overrides"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}