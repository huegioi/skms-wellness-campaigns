{
  "name": "CampaignCta",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Display label shown in the wizard and chips, e.g. 'Book a Demo Call'"
    },
    "url": {
      "type": "string",
      "description": "Destination URL Maya weaves into drafted emails as a plain link"
    },
    "guidance": {
      "type": "string",
      "description": "Optional hint for Maya on when/how to use this CTA, e.g. 'primary CTA for warm partner leads'"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this CTA is offered in the campaign wizard. Deactivating hides it from future campaigns; records are never deleted."
    },
    "sort_order": {
      "type": "number",
      "description": "Display order in the wizard list (ascending)"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True if this record is demo/broker-demo sample data."
    }
  },
  "required": [
    "label",
    "url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}