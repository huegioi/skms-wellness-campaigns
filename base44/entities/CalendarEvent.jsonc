{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "meeting",
        "workshop",
        "challenge",
        "leadership",
        "class",
        "delivery",
        "follow_up",
        "presentation",
        "other"
      ],
      "description": "Type of event"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Event start date and time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Event end date and time"
    },
    "all_day": {
      "type": "boolean",
      "default": false,
      "description": "Is this an all-day event"
    },
    "client_id": {
      "type": "string",
      "description": "Associated client ID"
    },
    "lead_id": {
      "type": "string",
      "description": "Associated lead ID (used when the event is booked with a Lead rather than a Client)"
    },
    "referral_partner_id": {
      "type": "string",
      "description": "Associated referral partner ID (used for quarterly reviews and partner-specific meetings)"
    },
    "client_name": {
      "type": "string",
      "description": "Contact name for display (client or lead name)"
    },
    "proposal_id": {
      "type": "string",
      "description": "Associated proposal ID"
    },
    "location": {
      "type": "string",
      "description": "Event location or meeting link"
    },
    "checkin_token": {
      "type": "string",
      "description": "Unique token for the public attendee check-in page (crypto.randomUUID()). Share the /Checkin?t= link in calendar invites instead of the raw video link."
    },
    "meeting_link": {
      "type": "string",
      "description": "Direct video call link (Zoom, Meet, Teams). Falls back to location if it's a URL."
    },
    "presenter": {
      "type": "string",
      "description": "Free-text presenter name (legacy \u2014 kept for backward compatibility)"
    },
    "presenter_id": {
      "type": "string",
      "description": "ID of the linked Presenter entity"
    },
    "presenter_accepted": {
      "type": "boolean",
      "description": "Whether the presenter has accepted this session"
    },
    "presenter_declined_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the assigned presenter declined this session. When set, presenter_id is cleared and the session needs a new presenter. Cleared when a new presenter accepts."
    },
    "presenter_decline_reason": {
      "type": "string",
      "description": "Optional reason the presenter gave for declining this session."
    },
    "presenter_email": {
      "type": "string",
      "format": "email",
      "description": "Speaker/presenter email \u2014 used to filter their portal view"
    },
    "presenter_fee": {
      "type": "number",
      "description": "Per-session fee override for this event. If blank, the presenter's default_rate applies."
    },
    "presenter_paid": {
      "type": "boolean",
      "default": false,
      "description": "Whether the presenter has been paid for this session"
    },
    "presenter_paid_date": {
      "type": "string",
      "format": "date",
      "description": "Date the presenter was paid for this session"
    },
    "service_id": {
      "type": "string",
      "description": "Associated Service ID \u2014 used to generate the feedback link for the speaker"
    },
    "recording_link": {
      "type": "string",
      "description": "URL of the session recording (Loom, Zoom, etc.) submitted by the presenter"
    },
    "delivery_format": {
      "type": "string",
      "enum": [
        "virtual",
        "in_person",
        "hybrid"
      ],
      "description": "How the session was delivered"
    },
    "color": {
      "type": "string",
      "description": "Event color for calendar display"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether reminder has been sent"
    },
    "invite_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether a calendar invite has been sent to attendees"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether event has been completed"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the event was marked as completed"
    },
    "google_event_id": {
      "type": "string",
      "description": "Google Calendar event ID for sync"
    },
    "outlook_event_id": {
      "type": "string",
      "description": "Outlook Calendar event ID for sync"
    },
    "source_calendar": {
      "type": "string",
      "description": "Which watched Google calendar this event was ingested from (e.g. 'primary', 'heather@skillfulmeans.life', 'admin@skillfulmeans.life'). Used to attribute touches to William vs Heather."
    },
    "ingested": {
      "type": "boolean",
      "default": false,
      "description": "True if this event was auto-ingested from Google Calendar ingestion (not manually created). Used to distinguish ingestion-created events from manually booked ones."
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True if this event is demo/broker-demo sample data. Never synced to Google Calendar (no google_event_id) and excluded from dashboards."
    }
  },
  "required": [
    "title",
    "start_date",
    "event_type"
  ]
}