{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "meeting",
        "workshop",
        "challenge",
        "leadership",
        "class",
        "delivery",
        "follow_up",
        "other"
      ],
      "description": "Type of event"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Event start date and time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Event end date and time"
    },
    "all_day": {
      "type": "boolean",
      "default": false,
      "description": "Is this an all-day event"
    },
    "client_id": {
      "type": "string",
      "description": "Associated client ID"
    },
    "client_name": {
      "type": "string",
      "description": "Client name for display"
    },
    "proposal_id": {
      "type": "string",
      "description": "Associated proposal ID"
    },
    "location": {
      "type": "string",
      "description": "Event location or meeting link"
    },
    "presenter": {
      "type": "string",
      "description": "Free-text presenter name (legacy \u2014 kept for backward compatibility)"
    },
    "presenter_id": {
      "type": "string",
      "description": "ID of the linked Presenter entity"
    },
    "presenter_accepted": {
      "type": "boolean",
      "description": "Whether the presenter has accepted this session"
    },
    "presenter_email": {
      "type": "string",
      "format": "email",
      "description": "Speaker/presenter email \u2014 used to filter their portal view"
    },
    "presenter_fee": {
      "type": "number",
      "description": "Per-session fee override for this event. If blank, the presenter's default_rate applies."
    },
    "presenter_paid": {
      "type": "boolean",
      "default": false,
      "description": "Whether the presenter has been paid for this session"
    },
    "presenter_paid_date": {
      "type": "string",
      "format": "date",
      "description": "Date the presenter was paid for this session"
    },
    "service_id": {
      "type": "string",
      "description": "Associated Service ID \u2014 used to generate the feedback link for the speaker"
    },
    "delivery_format": {
      "type": "string",
      "enum": [
        "virtual",
        "in_person",
        "hybrid"
      ],
      "description": "How the session was delivered"
    },
    "color": {
      "type": "string",
      "description": "Event color for calendar display"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether reminder has been sent"
    },
    "invite_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether a calendar invite has been sent to attendees"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether event has been completed"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the event was marked as completed"
    },
    "google_event_id": {
      "type": "string",
      "description": "Google Calendar event ID for sync"
    },
    "outlook_event_id": {
      "type": "string",
      "description": "Outlook Calendar event ID for sync"
    }
  },
  "required": [
    "title",
    "start_date",
    "event_type"
  ]
}