{
  "name": "MayaReminder",
  "type": "object",
  "properties": {
    "reminder_type": {
      "type": "string",
      "enum": [
        "workshop_recording",
        "challenge_report",
        "week_out_confirmation",
        "proposal_promo",
        "wellness_box"
      ],
      "description": "Type of follow-up reminder"
    },
    "dedupe_key": {
      "type": "string",
      "description": "Unique stable key, e.g. 'workshop_recording:<event_id>'"
    },
    "text": {
      "type": "string",
      "description": "Full display line for the brief"
    },
    "client_id": {
      "type": "string",
      "description": "Associated client ID"
    },
    "client_name": {
      "type": "string",
      "description": "Client display name"
    },
    "source_event_id": {
      "type": "string",
      "description": "Source CalendarEvent ID (optional)"
    },
    "source_proposal_id": {
      "type": "string",
      "description": "Source Proposal ID (optional)"
    },
    "trigger_date": {
      "type": "string",
      "format": "date",
      "description": "The day the reminder became due"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "done"
      ],
      "default": "open",
      "description": "Reminder status \u2014 stays open until manually checked off"
    },
    "completed_by": {
      "type": "string",
      "description": "Who checked off the reminder (optional)"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the reminder was checked off (optional)"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True if this record is demo/broker-demo sample data."
    }
  },
  "required": [
    "reminder_type",
    "dedupe_key",
    "text",
    "trigger_date",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}