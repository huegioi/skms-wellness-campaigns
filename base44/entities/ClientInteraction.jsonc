{
  "name": "ClientInteraction",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Associated client ID (optional — at least one of client_id / lead_id / referral_partner_id is required, enforced in code)"
    },
    "lead_id": {
      "type": "string",
      "description": "Associated lead ID (optional)"
    },
    "referral_partner_id": {
      "type": "string",
      "description": "Associated referral partner ID (optional)"
    },
    "proposal_id": {
      "type": "string",
      "description": "Associated proposal ID (optional)"
    },
    "calendar_event_id": {
      "type": "string",
      "description": "Linked CalendarEvent ID (optional)"
    },
    "email_log_id": {
      "type": "string",
      "description": "Linked EmailLog ID (optional)"
    },
    "interaction_type": {
      "type": "string",
      "enum": [
        "call",
        "email",
        "meeting",
        "note"
      ],
      "description": "Broad interaction category (legacy)"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "call",
        "text",
        "linkedin",
        "meeting",
        "other"
      ],
      "description": "Contact channel for this touch"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time of interaction"
    },
    "subject": {
      "type": "string",
      "description": "Brief subject/title of interaction"
    },
    "notes": {
      "type": "string",
      "description": "Detailed notes about the interaction"
    },
    "outcome": {
      "type": "string",
      "description": "Result or next steps from interaction"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "description": "Scheduled follow-up date"
    },
    "owner": {
      "type": "string",
      "description": "Team member who owns/made this touch (e.g. 'William', 'Heather'). Set from the source calendar when ingested from Google Calendar."
    }
  },
  "required": [
    "interaction_type",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}
