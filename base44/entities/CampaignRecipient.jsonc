{
  "name": "CampaignRecipient",
  "properties": {
    "approved_at": {
      "description": "When the draft was approved for sending",
      "format": "date-time",
      "type": "string"
    },
    "campaign_id": {
      "description": "Associated OutreachCampaign ID",
      "type": "string"
    },
    "cc_emails": {
      "description": "CC email addresses for this recipient draft",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "company": {
      "description": "Recipient company (snapshot at audience build time)",
      "type": "string"
    },
    "contact_name_missing": {
      "description": "No human name is known for this address (set by buildCampaignAudience).",
      "type": "boolean"
    },
    "draft_body": {
      "description": "Maya-generated draft email body",
      "type": "string"
    },
    "draft_concerns": {
      "description": "Anything Maya thinks the sender should check before sending.",
      "type": "string"
    },
    "draft_context": {
      "description": "The brief Maya wrote this draft from (what she knew about the recipient). Shown as 'What Maya used'.",
      "type": "string"
    },
    "draft_hooks": {
      "description": "The specific facts from the brief this draft relies on.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "draft_mailbox": {
      "description": "Email address of the Gmail account where the outreach draft was created",
      "type": "string"
    },
    "draft_subject": {
      "description": "Maya-generated draft subject line",
      "type": "string"
    },
    "drafted_at": {
      "description": "When the draft was generated by Maya",
      "format": "date-time",
      "type": "string"
    },
    "duplicate_warning": {
      "description": "Warning text if this recipient's email appears in another campaign with drafted-or-later status in the last 30 days",
      "type": "string"
    },
    "edit_ratio": {
      "description": "Share of words changed between Maya's version and what went out (0 = untouched, 1 = fully rewritten)",
      "type": "number"
    },
    "email": {
      "description": "Recipient email (snapshot at audience build time)",
      "type": "string"
    },
    "email_log_id": {
      "description": "Associated EmailLog ID",
      "type": "string"
    },
    "error_message": {
      "description": "Error details if drafting or sending failed",
      "type": "string"
    },
    "feedback_note": {
      "description": "Reviewer feedback or notes",
      "type": "string"
    },
    "final_body": {
      "description": "Body of what actually went out (signature and quoted thread removed): read from Gmail Sent when found, otherwise the approved version",
      "type": "string"
    },
    "final_captured_at": {
      "description": "When final_body was captured",
      "format": "date-time",
      "type": "string"
    },
    "final_source": {
      "description": "Where final_body came from",
      "enum": [
        "approved",
        "gmail_sent"
      ],
      "type": "string"
    },
    "final_subject": {
      "description": "Subject of what actually went out: read from Gmail Sent when found, otherwise the approved version",
      "type": "string"
    },
    "followup_round": {
      "default": 0,
      "description": "0 = original outreach; 1-3 = a follow-up bump descended from a round-0 recipient. Capped at 3 (4 total touches per person).",
      "type": "integer"
    },
    "gmail_draft_id": {
      "description": "Gmail draft ID after being pushed to Gmail Drafts",
      "type": "string"
    },
    "interaction_id": {
      "description": "Associated ClientInteraction ID",
      "type": "string"
    },
    "launch_id": {
      "description": "CampaignFollowUpLaunch ID that created this follow-up row (set on bump rows only).",
      "type": "string"
    },
    "maya_body": {
      "description": "Body exactly as Maya last generated it (kept even after the draft is edited in the app) \u2014 the before side of writing-style learning",
      "type": "string"
    },
    "maya_subject": {
      "description": "Subject exactly as Maya last generated it (kept even after the draft is edited in the app) \u2014 the before side of writing-style learning",
      "type": "string"
    },
    "name": {
      "description": "Recipient display name (snapshot at audience build time)",
      "type": "string"
    },
    "owner": {
      "description": "Record owner (snapshot at audience build time)",
      "type": "string"
    },
    "parent_recipient_id": {
      "description": "The round-0 CampaignRecipient row this bump descends from (set on follow-up rows only).",
      "type": "string"
    },
    "record_id": {
      "description": "Entity ID of the recipient",
      "type": "string"
    },
    "record_type": {
      "description": "Which entity type this recipient is",
      "enum": [
        "client",
        "lead",
        "referral_partner"
      ],
      "type": "string"
    },
    "replied_at": {
      "description": "When a reply was detected",
      "format": "date-time",
      "type": "string"
    },
    "rfc_message_id": {
      "description": "RFC 822 Message-ID header of the sent message, used for the In-Reply-To/References headers of a follow-up draft. Backfilled by syncCampaignSendStatus.",
      "type": "string"
    },
    "sent_at": {
      "description": "When the draft was pushed to Gmail Drafts",
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "description": "Recipient draft lifecycle status",
      "enum": [
        "pending",
        "drafting",
        "drafted",
        "approved",
        "sent",
        "replied",
        "skipped",
        "error"
      ],
      "type": "string"
    },
    "style_learned_at": {
      "description": "When the writing-style learner processed this email",
      "format": "date-time",
      "type": "string"
    },
    "style_status": {
      "description": "Writing-style learning state for this email",
      "enum": [
        "pending",
        "unchanged",
        "learned",
        "skipped"
      ],
      "type": "string"
    },
    "thin_context": {
      "default": false,
      "description": "True if the recipient record had no interactions and no email history (thin context)",
      "type": "boolean"
    },
    "thread_id": {
      "description": "Gmail threadId of the sent message, so a follow-up draft can be created on the same thread. Backfilled by syncCampaignSendStatus when a sent message is found.",
      "type": "string"
    }
  },
  "required": [
    "campaign_id",
    "record_id"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}