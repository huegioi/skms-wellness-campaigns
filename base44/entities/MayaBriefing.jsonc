{
  "name": "MayaBriefing",
  "type": "object",
  "properties": {
    "briefing_text": {
      "type": "string",
      "description": "Full briefing text from Maya"
    },
    "stats": {
      "type": "object",
      "description": "Stats snapshot: overdue_partners, silent_clients, renewal_clients, active_partners"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this briefing was generated"
    },
    "checked_items": {
      "type": "object",
      "description": "Map of action item key -> { name, timestamp } for completed items"
    },
    "sales_snapshot": {
      "type": "object",
      "description": "Structured sales figures for the brief's Sales section (stalled proposals, meetings with no follow-up, overdue leads, quiet partners). Rendered directly \u2014 never passed through the LLM \u2014 so the numbers on screen are the real ones."
    },
    "delivery_snapshot": {
      "type": "object",
      "description": "Structured delivery snapshot rendered separately from the LLM briefing text: todayTomorrowSessions, presenterGapSessions, challengeAssessmentGaps, unscheduledServicesTotal, clientsWithDelivery, activeCohort, renewalReviewGaps"
    }
  },
  "required": [
    "briefing_text",
    "generated_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}