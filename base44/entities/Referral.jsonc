{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referral_partner_id": {
      "type": "string",
      "description": "ID of the ReferralPartner who submitted this referral"
    },
    "referral_partner_name": {
      "type": "string",
      "description": "Partner name for display"
    },
    "referred_lead_id": {
      "type": "string",
      "description": "ID of the Lead entity created for this referral"
    },
    "referred_client_id": {
      "type": "string",
      "description": "ID of the Client entity if the lead converts to a client"
    },
    "contact_name": {
      "type": "string",
      "description": "Name of the referred contact"
    },
    "contact_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the referred contact"
    },
    "company_name": {
      "type": "string",
      "description": "Company name of the referred contact"
    },
    "notes": {
      "type": "string",
      "description": "Notes from the partner about this referral"
    },
    "referral_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the referral was submitted"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "submitted",
        "contacted",
        "converted_to_client",
        "purchased",
        "commission_paid",
        "not_eligible"
      ],
      "default": "pending_review",
      "description": "Current status of this referral"
    },
    "review_notes": {
      "type": "string",
      "description": "Admin notes from the review process"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this referral was reviewed"
    },
    "first_year_revenue": {
      "type": "number",
      "default": 0,
      "description": "First-year revenue generated by this placed client"
    },
    "commission_rate": {
      "type": "number",
      "description": "Commission rate applied to this referral (as decimal)"
    },
    "commission_amount": {
      "type": "number",
      "default": 0,
      "description": "Calculated commission amount for this referral"
    },
    "invoice_id": {
      "type": "string",
      "description": "ID of the Invoice linked to this placement"
    },
    "proposal_id": {
      "type": "string",
      "description": "Optional proposal the partner linked when submitting this referral"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True if this record is demo/broker-demo sample data. Excluded from all syncs and dashboard/analytics metrics."
    }
  },
  "required": [
    "referral_partner_id",
    "contact_name",
    "referral_date"
  ]
}