{
  "name": "ScanLead",
  "type": "object",
  "description": "A person who scanned a conference QR code (/Scan) and left their name, company and email. Held for review on the Dashboard Review Queue \u2014 nothing is filed into Clients or Partners until William or Heather chooses. Notes, tags and the LinkedIn link travel with them when filed. Written by the public submitScanLead function; LinkedIn looked up by findScanLinkedIn; reviewed via reviewScanLead.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name as typed by the visitor"
    },
    "company": {
      "type": "string",
      "description": "Company name as typed by the visitor"
    },
    "email": {
      "type": "string",
      "description": "Email as typed by the visitor (lower-cased)"
    },
    "source_key": {
      "type": "string",
      "description": "Which QR code they scanned (qrLinks.js key: quickbuilder, journey, roi, demo, call, william, heather)"
    },
    "source_label": {
      "type": "string",
      "description": "Human label of the QR code, e.g. 'Quick Builder'"
    },
    "notes": {
      "type": "string",
      "description": "William/Heather's notes from the conversation, added in the Review Queue; copied onto the record when filed"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tag labels (shared Tag pool, e.g. 'ITC Vegas 2026'); copied onto the record when filed"
    },
    "linkedin_url": {
      "type": "string",
      "description": "LinkedIn profile (https://www.linkedin.com/in/...) \u2014 found by the automatic web search or pasted by hand; copied onto the record when filed"
    },
    "linkedin_status": {
      "type": "string",
      "enum": [
        "searching",
        "found",
        "not_found",
        "error",
        "manual"
      ],
      "description": "State of the automatic LinkedIn lookup (empty = not tried yet)"
    },
    "linkedin_headline": {
      "type": "string",
      "description": "Name / headline of the matched profile, shown on the card so the match can be checked"
    },
    "linkedin_confidence": {
      "type": "string",
      "description": "high / medium \u2014 how sure the lookup was"
    },
    "linkedin_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the lookup last ran"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "added_client_lead",
        "added_partner_lead",
        "dismissed"
      ],
      "default": "pending_review",
      "description": "Review state"
    },
    "client_id": {
      "type": "string",
      "description": "Client (Client Lead) this scan was filed as"
    },
    "referral_partner_id": {
      "type": "string",
      "description": "ReferralPartner (Partner Lead) this scan was filed as"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of whoever reviewed it"
    },
    "review_notes": {
      "type": "string"
    },
    "scan_count": {
      "type": "number",
      "default": 1,
      "description": "Times this email submitted the same code within the dedupe window"
    }
  },
  "required": [
    "email",
    "source_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}