{
  "name": "Tag",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The tag label, e.g. \"NABIP NJ 2026\". Treated as unique (case-insensitive)."
    },
    "color": {
      "type": "string",
      "description": "A hex color for the tag chip, e.g. \"#10b981\""
    },
    "description": {
      "type": "string",
      "description": "What the tag means"
    }
  },
  "required": [
    "name",
    "color"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "user"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "user"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "user"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "user"
          ]
        }
      }
    }
  }
}