{
  "name": "FeedbackResponse",
  "type": "object",
  "properties": {
    "survey_id": {
      "type": "string",
      "description": "Legacy: ID of the FeedbackSurvey this response belongs to"
    },
    "service_id": {
      "type": "string",
      "description": "Foreign key to the Service entity"
    },
    "service_name": {
      "type": "string",
      "description": "Name of the service (denormalized for display)"
    },
    "service_category": {
      "type": "string",
      "enum": [
        "workshop",
        "challenge",
        "leadership",
        "class",
        "wellness_box"
      ],
      "description": "Category of the service delivered (denormalized for filtering)"
    },
    "client_id": {
      "type": "string",
      "description": "Foreign key to the Client entity"
    },
    "event_label": {
      "type": "string",
      "description": "Optional label for this specific delivery (e.g. 'May 2026 All-Hands')"
    },
    "full_name": {
      "type": "string",
      "description": "Full name of the respondent (optional)"
    },
    "company_name": {
      "type": "string",
      "description": "Company name of the respondent (denormalized)"
    },
    "email_address": {
      "type": "string",
      "format": "email",
      "description": "Email address of the respondent (optional)"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the feedback was submitted"
    },
    "presenter": {
      "type": "string",
      "description": "Name of the speaker/facilitator who delivered the session (denormalized)"
    },
    "delivery_format": {
      "type": "string",
      "enum": [
        "virtual",
        "in_person",
        "hybrid"
      ],
      "description": "How the session was delivered"
    },
    "behavior_intent": {
      "type": "string",
      "description": "Q1: One specific micro-action the respondent plans to take (\u2264140 chars)"
    },
    "fit_confidence": {
      "type": "number",
      "description": "Q2: Confidence they can apply the micro-action to daily life (0-10)"
    },
    "expected_impact": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Q3: Impact areas selected (multi-select). Options: Personal well-being and stress levels, Daily focus and productivity, Communication and teamwork, Resilience and workplace challenges, Overall job satisfaction"
    },
    "pre_stress_impact": {
      "type": "number",
      "description": "Legacy ROI metric: stress reduction (1-5 scale)"
    },
    "tool_equipped_confidence": {
      "type": "number",
      "description": "Legacy ROI metric: tool confidence (1-5 scale)"
    },
    "pressure_management_ability": {
      "type": "number",
      "description": "Legacy ROI metric: pressure management (1-5 scale)"
    },
    "nps_score": {
      "type": "number",
      "description": "Legacy: Net Promoter Score (0-10)"
    },
    "biggest_takeaway": {
      "type": "string",
      "description": "Legacy: biggest takeaway text"
    },
    "answers": {
      "type": "array",
      "description": "Legacy: list of question/answer pairs",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string"
          },
          "question_text": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "raffle_address": {
      "type": "string",
      "description": "Legacy: raffle mailing address"
    },
    "overall_rating": {
      "type": "number",
      "description": "Legacy: calculated average rating"
    }
  },
  "required": [
    "submitted_at"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}