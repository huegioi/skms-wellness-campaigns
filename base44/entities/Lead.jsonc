{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Contact name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Primary contact email address"
    },
    "email2": {
      "type": "string",
      "format": "email",
      "description": "Secondary contact email address"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "title": {
      "type": "string",
      "description": "Job title"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "linkedin_url": {
      "type": "string",
      "description": "LinkedIn profile URL"
    },
    "address": {
      "type": "string",
      "description": "Mailing or office address"
    },
    "industry": {
      "type": "string",
      "description": "Industry sector"
    },
    "company_size": {
      "type": "string",
      "description": "Estimated company size"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tag labels applied to this lead (shared pool with Client)"
    },
    "lead_type": {
      "type": "string",
      "enum": [
        "broker",
        "broker_lead",
        "ec",
        "company_inquiry"
      ],
      "default": "broker",
      "description": "Type of lead: broker (cold outreach), broker_lead (high-quality referral partner), ec (engagement consultant), company_inquiry (self-serve Quick Builder submission)"
    },
    "partner_status": {
      "type": "string",
      "enum": [
        "new",
        "nurturing",
        "active_partner",
        "inactive"
      ],
      "default": "new",
      "description": "Relationship development stage (for broker leads)"
    },
    "referral_potential": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Estimated referral potential"
    },
    "last_referral_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last referral from this partner"
    },
    "referral_count": {
      "type": "number",
      "default": 0,
      "description": "Number of referrals received from this partner"
    },
    "referral_history": {
      "type": "array",
      "description": "Log of individual referrals from this partner",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "company_name": {
            "type": "string"
          },
          "contact_name": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "cold",
        "contacted",
        "responded",
        "in_conversation",
        "meeting_scheduled",
        "proposal_sent",
        "converted",
        "not_interested",
        "current_client"
      ],
      "default": "cold",
      "description": "Outreach status. 'in_conversation' is the canonical value; 'responded' is a legacy synonym (normalized to in_conversation in the UI)."
    },
    "last_contacted_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last outreach"
    },
    "next_followup_date": {
      "type": "string",
      "format": "date",
      "description": "Scheduled next follow-up date"
    },
    "outreach_channel": {
      "type": "string",
      "enum": [
        "email",
        "linkedin",
        "phone",
        "referral",
        "event",
        "other"
      ],
      "description": "Primary outreach channel"
    },
    "notes": {
      "type": "string",
      "description": "Notes about this lead"
    },
    "source": {
      "type": "string",
      "description": "How this lead was sourced"
    },
    "sheet_row_id": {
      "type": "string",
      "description": "Identifier for syncing with Google Sheet row"
    },
    "sheet_origin": {
      "type": "string",
      "description": "Which Google Sheet tab this lead came from (e.g. Brokers, Engagement Consultants)"
    },
    "converted_client_id": {
      "type": "string",
      "description": "Client ID if this lead was converted to a client"
    },
    "referral_partner_id": {
      "type": "string",
      "description": "The ReferralPartner record for this same person, when one exists. Set by mergePartnerDuplicates to cross-reference the two records without deleting either."
    },
    "brokerage_id": {
      "type": "string",
      "description": "ID of the Brokerage this lead belongs to. Used for grouping broker leads under their parent firm."
    },
    "follow_up_stage": {
      "type": "string",
      "description": "Current follow-up stage in the outreach sequence (legacy \u2014 pipeline board now uses 'status'). Data preserved for reference and tagging."
    },
    "follow_up_due_date": {
      "type": "string",
      "format": "date",
      "description": "Date the next follow-up action is due"
    },
    "owner": {
      "type": "string",
      "description": "Team member responsible for this lead"
    },
    "kajabi_contact_id": {
      "type": "string",
      "description": "Durable Kajabi contact ID for direct API lookups (skips unreliable email filter)"
    },
    "quickbuilder_selections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Service IDs selected via the public Quick Builder form (stored on the Lead until reviewed; does not enter the proposal pipeline)"
    },
    "estimated_investment": {
      "type": "number",
      "description": "Estimated campaign investment computed from Quick Builder selections (rate card estimate)"
    },
    "matched_stage": {
      "type": "string",
      "description": "Closest campaign stage matched from Quick Builder selections (e.g. 'Stage 2 \u2014 Habit')"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True if this record is demo/broker-demo sample data. Excluded from all syncs (Sheets, Kajabi), Maya briefings, and dashboard/analytics metrics."
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Archived from the pre-2026 sales process. Excluded from all lists, counts, and pipelines. Not deleted."
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}