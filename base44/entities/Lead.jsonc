{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Contact name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Primary contact email address"
    },
    "email2": {
      "type": "string",
      "format": "email",
      "description": "Secondary contact email address"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "title": {
      "type": "string",
      "description": "Job title"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "industry": {
      "type": "string",
      "description": "Industry sector"
    },
    "company_size": {
      "type": "string",
      "description": "Estimated company size"
    },
    "lead_type": {
      "type": "string",
      "enum": [
        "broker",
        "broker_lead",
        "ec"
      ],
      "default": "broker",
      "description": "Type of lead: broker (cold outreach), broker_lead (high-quality referral partner), ec (engagement consultant)"
    },
    "partner_status": {
      "type": "string",
      "enum": [
        "new",
        "nurturing",
        "active_partner",
        "inactive"
      ],
      "default": "new",
      "description": "Relationship development stage (for broker leads)"
    },
    "referral_potential": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Estimated referral potential"
    },
    "last_referral_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last referral from this partner"
    },
    "referral_count": {
      "type": "number",
      "default": 0,
      "description": "Number of referrals received from this partner"
    },
    "referral_history": {
      "type": "array",
      "description": "Log of individual referrals from this partner",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "company_name": {
            "type": "string"
          },
          "contact_name": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "cold",
        "contacted",
        "responded",
        "meeting_scheduled",
        "proposal_sent",
        "converted",
        "not_interested",
        "current_client"
      ],
      "default": "cold",
      "description": "Outreach status"
    },
    "last_contacted_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last outreach"
    },
    "next_followup_date": {
      "type": "string",
      "format": "date",
      "description": "Scheduled next follow-up date"
    },
    "outreach_channel": {
      "type": "string",
      "enum": [
        "email",
        "linkedin",
        "phone",
        "referral",
        "other"
      ],
      "description": "Primary outreach channel"
    },
    "notes": {
      "type": "string",
      "description": "Notes about this lead"
    },
    "source": {
      "type": "string",
      "description": "How this lead was sourced"
    },
    "sheet_row_id": {
      "type": "string",
      "description": "Identifier for syncing with Google Sheet row"
    },
    "sheet_origin": {
      "type": "string",
      "description": "Which Google Sheet tab this lead came from (e.g. Brokers, Engagement Consultants)"
    },
    "converted_client_id": {
      "type": "string",
      "description": "Client ID if this lead was converted to a client"
    }
  },
  "required": [
    "name",
    "email"
  ]
}