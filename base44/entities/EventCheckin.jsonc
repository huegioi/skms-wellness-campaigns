{
  "name": "EventCheckin",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID of the CalendarEvent this check-in belongs to"
    },
    "client_id": {
      "type": "string",
      "description": "Client ID copied from the CalendarEvent at check-in time. Null if the event has no client \u2014 surfaces as an 'unmatched' check-in in the portal."
    },
    "name": {
      "type": "string",
      "description": "Attendee's display name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Attendee's work email (lowercased + trimmed)"
    },
    "checked_in_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the attendee checked in (full ISO timestamp)"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True if this record is demo/broker-demo sample data."
    }
  },
  "required": [
    "event_id",
    "email",
    "checked_in_at"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}