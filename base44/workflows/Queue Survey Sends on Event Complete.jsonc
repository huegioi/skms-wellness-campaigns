{
  "name": "Queue Survey Sends on Event Complete",
  "description": "When a CalendarEvent is updated, triggers queueSurveySendsForEvent to queue cohort_end and cohort_1mo sends if an endpoint event was marked completed.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"completed\") != null) and (.trigger.data.completed == true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "CalendarEvent"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "queue_survey_sends_on_event_complete",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "queueSurveySendsForEvent",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "queueSurveySendsForEvent"
  }
}