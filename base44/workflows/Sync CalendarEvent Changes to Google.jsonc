{
  "name": "Sync CalendarEvent Changes to Google",
  "description": "Automatically sync CalendarEvent changes to Google Calendar when events are updated or deleted",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update",
        "delete"
      ],
      "entity_name": "CalendarEvent"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_calendarevent_changes_to_google",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "handleCalendarEventChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "handleCalendarEventChange"
  }
}