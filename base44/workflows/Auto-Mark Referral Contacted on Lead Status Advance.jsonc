{
  "name": "Auto-Mark Referral Contacted on Lead Status Advance",
  "description": "When a Lead's status advances beyond new/contacted, mark its linked Referral as contacted (once).",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Lead"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_mark_referral_contacted_on_lead_status_advance",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "markReferralContacted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "markReferralContacted"
  }
}