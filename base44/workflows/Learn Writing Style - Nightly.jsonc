{
  "name": "Learn Writing Style - Nightly",
  "description": "Reads newly sent campaign emails from Gmail (read-only), compares them with Maya's drafts, and updates William's and Heather's writing-style profiles that new campaign drafts follow. Never sends anything. Runs learnWritingStyle.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "40 3 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {},
            "function_name": "learnWritingStyle"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "learn_writing_style_nightly",
      "namespace": "base44",
      "version": "1.0"
    }
  }
