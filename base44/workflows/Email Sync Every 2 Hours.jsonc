{
  "name": "Email Sync Every 2 Hours",
  "description": "Syncs Gmail emails (William, Heather, admin@) into the EmailLog entity every 2 hours. Scans the last 3 days each run (overlap is deduped) and stops at a time budget so it never hits the 5-minute limit.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 2,
      "interval_unit": "hours",
      "interval_anchor": "2026-05-29T15:12:14.147000Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "days_back": 60,
              "skip_lead_stages": true
            },
            "function_name": "scanAdminGmailContacts"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "email_sync_every_2_hours",
      "namespace": "base44",
      "version": "1.0"
    }
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "scanAdminGmailContacts"
  }
}