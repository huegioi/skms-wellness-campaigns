{
  "name": "Calendar Ingestion - Every 15 Min",
  "description": "Scheduled run of calendar ingestion every 15 minutes. Covers all watched calendars (primary, Heather, admin) \u2014 the webhook only fires for the primary calendar, so this ensures Heather's and admin's events are ingested too.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 15,
      "interval_unit": "minutes",
      "interval_anchor": "2026-07-07T14:42:29.205000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "calendar_ingestion_every_15_min",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "updateLastContactedFromCalendar",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "updateLastContactedFromCalendar"
  }
}